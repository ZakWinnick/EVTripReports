---
// Full-width photo band. Images are self-hosted in public/images (CSP allows only 'self').
// Each source is cropped to 2.4:1 at 1000 and 2000 px wide.
interface Props {
  name: string;
  alt: string;
  caption: string;
  credit: string;
  href: string;
  source?: { name: string; title: string };
  license?: string;
  licenseUrl?: string;
  eager?: boolean;
}
const { name, alt, caption, credit, href, source, license, licenseUrl, eager = false } = Astro.props;
---
<figure class="photoband">
  <img
    src={`/images/${name}-2000.webp`}
    srcset={`/images/${name}-1000.webp 1000w, /images/${name}-2000.webp 2000w`}
    sizes="100vw"
    width="2000"
    height="833"
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
  <figcaption class="wrap">
    {caption}{' '}
    {source ? (
      <>
        Photo via <a href={href}>{source.name}</a>{licenseUrl && <>, <a href={licenseUrl}>{license}</a></>}
        <details class="photoband__credit">
          <summary>Full credit</summary>
          <div><a href={href}>{source.title}</a> by {credit}. Cropped for this page.</div>
        </details>
      </>
    ) : (
      <>Photo: <a href={href}>{credit}</a>{licenseUrl && <> · <a href={licenseUrl}>{license}</a> · cropped</>}</>
    )}
  </figcaption>
</figure>
