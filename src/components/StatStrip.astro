---
interface Stat { label: string; value: string; unit?: string; }
interface Props { stats: Stat[]; }
const { stats } = Astro.props;
---
<dl class="specs">
  {stats.map((s) => (
    <div class="spec">
      <dt class="spec__l">{s.label}</dt>
      <dd class="spec__v" style="margin:0">{s.value}{s.unit && <span class="spec__u">{s.unit}</span>}</dd>
    </div>
  ))}
</dl>
<style>
  .specs .spec { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
  .specs .spec__l { margin-top: 10px; }
</style>
