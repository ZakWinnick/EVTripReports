---
// Build-time version of each guide. When a live row exists in D1,
// functions/guides/[[path]].js serves that instead, with the same renderer.
import Base from '../../layouts/Base.astro';
import { guideMain, guideMeta } from '../../lib/render-guide.js';

export async function getStaticPaths() {
  const list = (await import('../../data/routes.json')).default as { slug: string; status: string }[];
  const live = new Set(list.filter((r) => r.status === 'live').map((r) => r.slug));
  const files = import.meta.glob('../../data/routes/*.json', { eager: true });
  return Object.values(files).flatMap((m: any) => {
    const route = m.default ?? m;
    if (!live.has(route.slug)) return [];
    return [{ params: { slug: route.slug }, props: { route } }];
  });
}

const { route } = Astro.props as { route: any };
const meta = guideMeta(route);
---
<Base title={meta.title.replace(' | EV Trip Reports', '')} description={meta.description}>
  <Fragment set:html={guideMain(route)} />
</Base>
