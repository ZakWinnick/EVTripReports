---
import Base from '../../layouts/Base.astro';
import RouteLine from '../../components/RouteLine.astro';
import StatStrip from '../../components/StatStrip.astro';
import Tag from '../../components/Tag.astro';

export async function getStaticPaths() {
  const files = import.meta.glob('../../data/routes/*.json', { eager: true });
  return Object.values(files).map((m: any) => {
    const route = m.default ?? m;
    return { params: { slug: route.slug }, props: { route } };
  });
}

const { route } = Astro.props as { route: any };
const S = route.sources as Record<string, { name: string; url: string }>;
const total = Number(route.stats[0].value);
const checked = route.checked;
const fmtDate = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const factRows = (p: any) => [
  { k: 'Network', v: p.network },
  { k: 'Address', v: p.address },
  { k: 'Exit', v: p.exit, status: p.exit === 'Not yet verified' ? 'unverified' : undefined },
  { k: 'Stalls', v: p.stalls.value, f: p.stalls },
  { k: 'Max power', v: p.power.value, f: p.power },
  { k: 'Access', v: p.access.value, f: p.access },
  { k: 'Price', v: p.price.value, f: p.price },
];

const stopSources = (s: any) => {
  const ids = new Set<string>();
  ['stalls', 'power', 'access', 'price'].forEach((k) => s.primary[k]?.source && ids.add(s.primary[k].source));
  s.backups.forEach((b: any) => b.source && ids.add(b.source));
  if (s.other.length) ids.add('afdc');
  s.reports.forEach((r: any) => ids.add(r.source));
  s.around.forEach((a: any) => ids.add(a.source));
  return [...ids].map((id) => S[id]).filter(Boolean);
};
---
<Base title={`${route.title} EV charging guide (${route.highway})`} description={`Stop-by-stop EV charging guide for ${route.title} on ${route.highway}. Stall counts, kW, access and prices checked against each network on ${fmtDate(checked)}.`}>
  <section class="band band--tight">
    <div class="wrap">
      <p class="muted" style="margin-bottom:14px"><a href="/#guides">Guides</a> <span aria-hidden="true">/</span> {route.highway}</p>
      <h1 class="h1">{route.title}</h1>
      <p class="lede" style="margin-top:18px">{route.summary}</p>
      <p class="small muted" style="margin-top:14px">Station facts checked {fmtDate(checked)}. Anything we couldn't confirm is labeled. <a href="/methodology">How we check</a></p>
      <div style="margin-top:40px"><StatStrip stats={route.stats} /></div>
    </div>
  </section>

  <section class="band band--tight band--mist">
    <div class="wrap">
      <div class="panel" style="padding: clamp(18px, 3vw, 32px)">
        <RouteLine stops={route.stops} total={total} startLabel={route.startLabel} endLabel={route.endLabel} />
      </div>
      <p class="small muted" style="margin-top:12px">{route.startNote} Stops are placed to scale.</p>
    </div>
  </section>

  {route.stops.map((s: any, i: number) => (
    <section id={`stop-${s.id}`} class={`band band--tight stop ${i % 2 ? 'band--mist' : ''}`}>
      <div class="wrap">
        <header class="stop__head">
          <span class="stop__num">{i + 1}</span>
          <div>
            <h2 class="h2">{s.name}</h2>
            <p class="muted" style="margin:6px 0 0">{s.towns}</p>
          </div>
          <div class="stop__mile">
            <span class="num">mile {s.mile}</span>
            <span class="small muted">{s.milepostNote}</span>
          </div>
        </header>
        <p class="stop__why">{s.why}</p>

        <div class="panel primary">
          <div class="primary__top">
            <div>
              <p class="small muted" style="margin:0 0 4px">Primary charger</p>
              <h3 class="h3">{s.primary.name}</h3>
            </div>
            <div class="btnrow">
              {s.primary.teslaAccess && <Tag status={s.primary.teslaAccess} />}
              <Tag status="verified" checked={checked} />
            </div>
          </div>
          <dl class="sheet">
            {factRows(s.primary).map((r) => (
              <div class="sheet__row">
                <dt>{r.k}</dt>
                <dd>
                  <span>{r.v}</span>
                  {r.f && r.f.status !== 'verified' && <Tag status={r.f.status} />}
                  {r.status && <Tag status={r.status} />}
                  {r.f && r.f.url && <a class="src" href={r.f.url} rel="nofollow noopener" target="_blank">Source</a>}
                </dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="cols">
          <div>
            <h3 class="h3 sub">Backups</h3>
            <ul class="list">
              {s.backups.map((b: any) => (
                <li class="item">
                  <div class="item__top">
                    <strong>{b.name}</strong>
                    <span class="btnrow">
                      {b.teslaAccess && <Tag status={b.teslaAccess} />}
                      <Tag status={b.status} checked={b.status === 'verified' ? checked : undefined} />
                    </span>
                  </div>
                  <p class="small muted item__meta">{b.network}. {b.address}</p>
                  <p class="item__facts">{b.facts}</p>
                  <p class="small item__meta">{b.access.replace(/\.$/, '')}. {b.url ? <a href={b.url} rel="nofollow noopener" target="_blank">Source: {S[b.source].name}</a> : <span class="muted">Source: {S[b.source].name}</span>}</p>
                </li>
              ))}
            </ul>
            {s.other.length > 0 && (
              <details class="other">
                <summary>Other DC sites nearby ({s.other.length}), DOE data only</summary>
                <ul class="list">
                  {s.other.map((o: any) => (
                    <li class="item">
                      <div class="item__top"><strong>{o.name}</strong><Tag status={o.status} /></div>
                      <p class="item__facts small">{o.facts}</p>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </div>
          <div>
            <h3 class="h3 sub">Driver reports</h3>
            {s.reports.length === 0 ? (
              <p class="muted">No recent driver reports found for this stop yet.</p>
            ) : (
              <ul class="list">
                {s.reports.map((r: any) => (
                  <li class="report">
                    <p class="report__text">{r.text}</p>
                    <p class="small muted" style="margin:0">
                      <time datetime={r.date}>{fmtDate(r.date)}</time>, {r.who} on <a href={S[r.source].url} rel="nofollow noopener" target="_blank">{r.where}</a>. About: {r.site}
                    </p>
                  </li>
                ))}
              </ul>
            )}
            {s.around.length > 0 && (
              <>
                <h3 class="h3 sub">Around the stop</h3>
                <ul class="plain">
                  {s.around.map((a: any) => <li>{a.text}</li>)}
                </ul>
              </>
            )}
            <h3 class="h3 sub">Sources for this stop</h3>
            <ul class="plain small">
              {stopSources(s).map((src: any) => <li><a href={src.url} rel="nofollow noopener" target="_blank">{src.name}</a></li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="band band--tight">
    <div class="wrap">
      <h2 class="h2">Tips for this route</h2>
      <ol class="tips">
        {route.tips.map((t: any) => (
          <li>{t.text} <a class="small" href={S[t.source].url} rel="nofollow noopener" target="_blank">Source</a></li>
        ))}
      </ol>
      <p class="note" style="margin-top:28px">{route.arrival} Lodging with chargers is also coming in the next update.</p>
    </div>
  </section>

  <section class="band band--tight band--mist">
    <div class="wrap plan-cta">
      <div>
        <h2 class="h2">Want this built around your car?</h2>
        <p class="lede" style="margin-top:12px">Tell us your car, adapter, and dates. We check every stop again before we send your plan.</p>
      </div>
      <a class="pill pill--lg" href="/plans#request">Plan my trip</a>
    </div>
  </section>
</Base>

<style>
  .stop__head { display: grid; grid-template-columns: auto 1fr auto; gap: 18px; align-items: center; }
  .stop__num { width: 52px; height: 52px; border-radius: 50%; background: var(--green); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 1.3rem; }
  .stop__mile { text-align: right; display: flex; flex-direction: column; font-weight: 600; font-size: 1.1rem; }
  .stop__why { margin: 22px 0 28px; font-size: 1.08rem; max-width: 62ch; }
  @media (max-width: 760px) {
    .stop__head { grid-template-columns: auto 1fr; }
    .stop__mile { grid-column: 1 / -1; text-align: left; }
  }
  .primary { padding: clamp(18px, 3vw, 28px); }
  .primary__top { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; flex-wrap: wrap; padding-bottom: 18px; border-bottom: 1px solid var(--ink); }
  .sheet { margin: 0; }
  .sheet__row { display: grid; grid-template-columns: 150px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .sheet__row:last-child { border-bottom: 0; padding-bottom: 0; }
  .sheet dt { color: var(--ink-2); font-size: 0.94rem; }
  .sheet dd { margin: 0; display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: baseline; font-variant-numeric: tabular-nums; }
  .sheet dd > span:first-child { font-weight: 500; }
  @media (max-width: 560px) { .sheet__row { grid-template-columns: 1fr; gap: 4px; } }
  .src { font-size: 0.82rem; color: var(--ink-2); }
  .cols { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(24px, 5vw, 64px); margin-top: 40px; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr; } }
  .sub { font-size: 1.15rem; margin: 0 0 14px; }
  .cols > div > .sub ~ .sub { margin-top: 36px; }
  .list { list-style: none; margin: 0; padding: 0; }
  .item { padding: 16px 0; border-top: 1px solid var(--line); }
  .item__top { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; flex-wrap: wrap; }
  .item__meta { margin: 4px 0 0; }
  .item__facts { margin: 8px 0 0; font-variant-numeric: tabular-nums; }
  .other { margin-top: 18px; border-top: 1px solid var(--line); padding-top: 14px; }
  .other summary { cursor: pointer; font-weight: 600; font-size: 0.94rem; }
  .other[open] summary { margin-bottom: 6px; }
  .report { padding: 14px 0; border-top: 1px solid var(--line); }
  .report__text { margin: 0 0 6px; }
  .plain { margin: 0; padding-left: 1.1em; }
  .plain li { margin: 6px 0; }
  .tips { margin: 24px 0 0; padding-left: 1.3em; max-width: 72ch; }
  .tips li { margin: 12px 0; padding-left: 6px; }
  .plan-cta { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
</style>
