---
// HERO: A readable trip sheet with the charging decision, backup, and assumptions together.
import Base from '../layouts/Base.astro';
import route from '../data/routes/la-to-las-vegas.json';
import { samplePlan } from '../lib/sample-plan.js';
import { fmtDate, routeLine } from '../lib/render-guide.js';
const plan = samplePlan(route);
const charging = plan.stops.filter((s: any) => s.charging);
const optional = plan.stops.filter((s: any) => !s.charging);
const sourceEntries = Object.values(plan.sources) as { name: string; url: string }[];
---
<Base title="Inside a custom EV trip plan" description="Explore an illustrative Detailed Plan for an EV trip from Ontario to Las Vegas, with charging targets, a backup, source dates, and clear assumptions.">
  <div class="sample-banner"><div class="wrap"><p><strong>Sample only.</strong> A made-up traveler and dated research. Not a current recommendation.</p><a href="/plans/">Compare Plans</a></div></div>
  <article class="sample-plan">
    <section class="band sample-intro"><div class="wrap"><div class="guide-hero__top"><p class="guide-crumb"><span class="shield shield--lg" role="img" aria-label="I-15"><span aria-hidden="true">15</span></span><span>Sample Detailed Plan, $39</span></p><div class="guide-tools"><button type="button" data-print>Print Sample</button></div></div>
      <div class="sample-summary"><div><h1 class="display">Ontario to Las Vegas</h1><p class="lede">224 miles on I-15, from the I-10 junction to Tropicana Avenue.</p><a class="text-link" href="/plans/?route=la-to-las-vegas#request">Plan This Route for My Car</a></div>
      <aside class="sample-profile"><h2 class="h3" style="margin-bottom:6px">The Example Traveler</h2><dl><div><dt>Vehicle</dt><dd>2024 Hyundai Ioniq 5</dd></div><div><dt>Connection</dt><dd>CCS + NACS adapter</dd></div><div><dt>Membership</dt><dd>EA Pass+</dd></div><div><dt>Starting battery</dt><dd>80% at Ontario</dd></div><div><dt>Departure</dt><dd>Nov 2, 2026, 8:00 a.m. Pacific</dd></div><div><dt>Travel party</dt><dd>2 adults + 1 dog</dd></div></dl></aside></div>
      <div id="assumptions" class="sample-assumptions"><strong>These are estimates.</strong><p style="margin:8px 0 14px">They assume 250 miles of range and 65 mph. Weather, climbing, and load will change them.</p><details><summary>All calculation assumptions</summary><ul>{plan.assumptions.map((text: string) => <li>{text}</li>)}</ul></details></div>
    </div></section>
    <section class="route-overview"><div class="wrap"><h2 class="h3" style="margin-bottom:8px">The Corridor at a Glance</h2><Fragment set:html={routeLine(route, '/guides/la-to-las-vegas/')} /><p class="small muted" style="margin:12px 0 0">This plan charges at Baker. The other stops are optional.</p></div></section>
    {charging.map((stop: any, i: number) => {
      const primary = stop.primary;
      const backup = stop.backups[0];
      const strategy = plan.strategy.stops.find((s: any) => s.stopId === stop.id);
      return <section class="band sample-detail"><div class="wrap"><header class="stop__head sample-stop-head"><span class="milemarker"><span>Mile</span>{stop.mile}</span><div><h2 class="h2">Charge at {stop.name}</h2><p class="muted" style="margin:6px 0 0">{charging.length === 1 ? 'The one planned charging stop' : `Charging stop ${i + 1} of ${charging.length}`}</p></div></header><p class="stop__why">{stop.why}</p><div class="stop-grid"><div class="panel primary"><p class="small muted" style="margin:0 0 4px;font-weight:700">Primary charger, {primary.network.value}</p><h3 class="h3">{primary.name}</h3><p class="small muted" style="margin-top:10px">{primary.address.value}</p><div class="sample-charge"><div><strong>{strategy.arrivePercent}%</strong><span>Estimated arrival</span></div><div><strong>{strategy.departPercent}%</strong><span>Estimated charge target</span></div></div><dl class="sheet">{[['Stalls', primary.stalls], ['Maximum power', primary.power], ['Access', primary.access], ['Pricing', primary.price]].map(([label, fact]: any) => <div class="sheet__row"><dt>{label}</dt><dd><span>{fact.value}</span><a class="src" href={fact.url} target="_blank" rel="noopener noreferrer">Source, {fmtDate(fact.checkedOn)}</a></dd></div>)}</dl><div class="primary-actions"><a class="pill" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(primary.address.value)}`} target="_blank" rel="noopener noreferrer">Open in Maps</a></div></div><aside class="stop-sidebar"><p class="small muted" style="margin:0 0 4px;font-weight:700">The backup</p><h3 class="h3">{backup?.name || 'Not yet verified'}</h3>{backup && <><p class="small" style="margin-top:12px">{backup.facts}</p><p class="small">{backup.access}</p><p class="small muted">{backup.address}</p><a class="src" href={backup.url} target="_blank" rel="noopener noreferrer">{backup.sourceName}, {fmtDate(backup.checkedOn)}</a></>}<div class="around-compact"><h3>Food and Facilities</h3>{stop.food?.map((item: any) => <p>{item.text} <a href={item.url} target="_blank" rel="noopener noreferrer">Source</a></p>)}<p>Restrooms and pet areas at the primary aren’t confirmed.</p></div></aside></div>
      <div class="sample-cautions"><h3 class="h3">What to Check Before You Arrive</h3><p class="small muted">Past driver reports, not live status. Check both stations in their apps.</p>{stop.cautions?.map((item: any) => <p><strong>{item.name}:</strong> {item.text} <a href={item.url} target="_blank" rel="noopener noreferrer">Driver report, {fmtDate(item.checkedOn)}</a></p>)}</div></div></section>;
    })}
    <section class="band band--mist"><div class="wrap guide-bottom"><div><h2 class="h2">Arrival in Las Vegas</h2><div class="sample-charge"><div><strong>{plan.strategy.destination.arrivePercent}%</strong><span>Estimated battery at Tropicana Ave</span></div></div><p class="small">Targets 15% on arrival, never below 10%. Sort out charging at your hotel before you leave.</p></div><div><details class="optional-stops"><summary>Other charging areas in this plan ({optional.length})</summary><ul>{optional.map((stop: any) => <li><strong>{stop.name}</strong><br /><span class="small">{stop.primary.name}. {stop.backups?.[0] ? `Backup: ${stop.backups[0].name}.` : 'No verified backup at this stop.'} <a href={`/guides/la-to-las-vegas/#stop-${stop.id}`}>Station details</a></span></li>)}</ul></details></div></div></section>
    <section class="band"><div class="wrap guide-bottom"><div><h2 class="h2">Traveler Notes</h2><ul class="tips">{plan.tips.map((tip: any) => <li>{tip.text} {tip.url && <a class="src" href={tip.url} target="_blank" rel="noopener noreferrer">Source</a>}</li>)}</ul></div><div><h2 class="h2">Sources and Dates</h2><p class="small" style="margin-top:20px">Every fact keeps its own date. This sample uses data from {plan.dataChecked}.</p><details class="other"><summary>Sources used in the sample</summary><ul class="sample-source-list">{sourceEntries.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.name}</a></li>)}</ul></details></div></div></section>
  </article>
  <section class="band band--tight"><div class="wrap"><div class="plan-cta"><div><h2 class="h2">Get a Plan for Your Trip</h2><p class="lede" style="margin-top:18px">Any route, built for your car.</p></div><a class="pill pill--lg" href="/plans/">Compare Plans</a></div></div></section>
</Base>

