---
// HERO: A readable trip sheet with the charging decision, backup, and assumptions together.
import Base from '../layouts/Base.astro';
import route from '../data/routes/la-to-las-vegas.json';
import { samplePlan } from '../lib/sample-plan.js';
import { fmtDate, routeLine } from '../lib/render-guide.js';
const plan = samplePlan(route);
const charging = plan.stops.filter((s: any) => s.charging);
const optional = plan.stops.filter((s: any) => !s.charging);
const sourceEntries = Object.values(plan.sources) as { name: string; url: string }[];
---
<Base title="Inside a custom EV trip plan" description="Explore an illustrative Detailed plan for an EV trip from Ontario to Las Vegas, with charging targets, a backup, source dates, and clear assumptions.">
  <div class="sample-banner"><div class="wrap"><p><strong>Illustrative sample.</strong> A fictional traveler, dated station research, and explicitly assumed range. Not a current trip recommendation.</p><a href="/plans/">Compare plans ↗</a></div></div>
  <article class="sample-plan">
    <section class="band sample-intro"><div class="wrap"><div class="guide-hero__top"><p class="eyebrow">Inside a detailed plan / $39</p><div class="guide-tools"><button type="button" data-print>Print sample ↗</button></div></div>
      <div class="sample-summary"><div><h1 class="h1">Ontario to<br />Las Vegas.</h1><p class="lede">I-10 junction, Ontario to Tropicana Avenue, Las Vegas. A charging strategy for the 224-mile corridor, with alternatives if the day changes.</p><p class="small muted">This example starts at the corridor boundary. It does not include the drive from home or onward to a hotel.</p><a class="text-link" href="/plans/?route=la-to-las-vegas#request">Plan this route for my car ↗</a></div>
      <aside class="sample-profile"><p class="eyebrow">The example traveler</p><dl><div><dt>Vehicle</dt><dd>2024 Hyundai Ioniq 5</dd></div><div><dt>Connection</dt><dd>CCS + NACS adapter</dd></div><div><dt>Membership</dt><dd>EA Pass+</dd></div><div><dt>Starting battery</dt><dd>80% at Ontario</dd></div><div><dt>Departure</dt><dd>Nov 2, 2026 · 8:00 a.m. Pacific</dd></div><div><dt>Travel party</dt><dd>2 adults + 1 dog</dd></div></dl></aside></div>
      <div id="assumptions" class="sample-assumptions"><strong>Read the estimates in context.</strong><p style="margin:8px 0 14px">This example assumes 250 miles of range, a 75 kWh battery, and 65 mph. These are illustrative inputs, not measured specifications or a tested charge curve for this car. Weather, climbing, traffic, and load can change the result. Use your vehicle’s navigation for the drive.</p><details><summary>All calculation assumptions</summary><ul>{plan.assumptions.map((text: string) => <li>{text}</li>)}</ul></details></div>
    </div></section>
    <section class="route-overview"><div class="wrap"><p class="eyebrow">The corridor at a glance</p><Fragment set:html={routeLine(route, '/guides/la-to-las-vegas/')} /><p class="small muted" style="margin:12px 0 0">Five charging areas to choose from. This illustrative strategy charges at Baker; the others are optional.</p></div></section>
    {charging.map((stop: any, i: number) => {
      const primary = stop.primary;
      const backup = stop.backups[0];
      const strategy = plan.strategy.stops.find((s: any) => s.stopId === stop.id);
      return <section class="band sample-detail"><div class="wrap"><p class="sample-stop-label">Charging stop {i + 1} / mile {stop.mile}</p><div class="section-head"><div><h2 class="h2">Charge at {stop.name}</h2><p class="muted">{stop.why}</p></div></div><div class="stop-grid"><div class="panel primary"><p class="eyebrow">Primary / {primary.network.value}</p><h3 class="h3">{primary.name}</h3><p class="small muted" style="margin-top:10px">{primary.address.value}</p><div class="sample-charge"><div><strong>{strategy.arrivePercent}%</strong><span>Estimated arrival</span></div><div><strong>{strategy.departPercent}%</strong><span>Estimated charge target</span></div></div><dl class="sheet">{[['Stalls', primary.stalls], ['Maximum power', primary.power], ['Access', primary.access], ['Pricing', primary.price]].map(([label, fact]: any) => <div class="sheet__row"><dt>{label}</dt><dd><span>{fact.value}</span><a class="src" href={fact.url} target="_blank" rel="noopener noreferrer">Source · {fmtDate(fact.checkedOn)}</a></dd></div>)}</dl><div class="primary-actions"><a class="pill" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(primary.address.value)}`} target="_blank" rel="noopener noreferrer">Open in maps ↗</a></div></div><aside class="stop-sidebar"><p class="eyebrow">The backup</p><h3 class="h3">{backup?.name || 'Not yet verified'}</h3>{backup && <><p class="small" style="margin-top:12px">{backup.facts}</p><p class="small">{backup.access}</p><p class="small muted">{backup.address}</p><a class="src" href={backup.url} target="_blank" rel="noopener noreferrer">{backup.sourceName} · {fmtDate(backup.checkedOn)}</a></>}<div class="around-compact"><h3>Food and facilities</h3>{stop.food?.map((item: any) => <p>{item.text} <a href={item.url} target="_blank" rel="noopener noreferrer">Source</a></p>)}<p>No sourced restroom or pet-facility note at the primary charger. Confirm before counting on either.</p></div></aside></div>
      <div class="sample-cautions"><h3 class="h3">What to check before you arrive</h3><p class="small muted">These are historical driver reports, not current charger status. Recheck both the primary and the backup in their network apps.</p>{stop.cautions?.map((item: any) => <p><strong>{item.name}:</strong> {item.text} <a href={item.url} target="_blank" rel="noopener noreferrer">Driver report · {fmtDate(item.checkedOn)}</a></p>)}</div></div></section>;
    })}
    <section class="band band--mist"><div class="wrap guide-bottom"><div><p class="eyebrow">At the destination</p><h2 class="h2">Arrival in Las Vegas</h2><div class="sample-charge"><div><strong>{plan.strategy.destination.arrivePercent}%</strong><span>Estimated battery at Tropicana Ave</span></div></div><p class="small">The illustration targets 15% on arrival, with a 10% reserve floor. These estimates cover the stated corridor only. Arrange charging at your actual destination before departure.</p><p class="small muted">No hotel or overnight charging has been verified for this example.</p></div><div><details class="optional-stops"><summary>Other charging areas in this plan ({optional.length})</summary><p class="small muted" style="margin-top:15px">Optional alternatives, not additional required stops.</p><ul>{optional.map((stop: any) => <li><strong>{stop.name}</strong><br /><span class="small">{stop.primary.name}. {stop.backups?.[0] ? `Backup: ${stop.backups[0].name}.` : 'No verified backup at this stop.'} <a href={`/guides/la-to-las-vegas/#stop-${stop.id}`}>Station details</a></span></li>)}</ul></details></div></div></section>
    <section class="band"><div class="wrap guide-bottom"><div><p class="eyebrow">For this traveler</p><h2 class="h2">Traveler notes</h2><ul class="tips">{plan.tips.map((tip: any) => <li>{tip.text} {tip.url && <a class="src" href={tip.url} target="_blank" rel="noopener noreferrer">Source</a>}</li>)}</ul></div><div><p class="eyebrow">Research</p><h2 class="h2">Sources and dates</h2><p class="small" style="margin-top:20px">Station facts and driver reports keep their own dates. The data used in this sample spans {plan.dataChecked}. It is a sample of the format, not a fresh check for your departure.</p><details class="sample-assumptions"><summary>Sources used in the sample</summary><ul class="sample-source-list">{sourceEntries.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.name}</a></li>)}</ul></details></div></div></section>
  </article>
  <section class="band band--tight"><div class="wrap"><div class="plan-cta"><div><p class="eyebrow">Custom planning</p><h2 class="h2">Get a plan for your trip.</h2><p class="lede" style="margin-top:18px">Tell us where you’re going and how you like to travel. A person reviews the plan before it reaches you.</p></div><a class="pill pill--lg" href="/plans/">Compare plans ↗</a></div></div></section>
</Base>
<style>.sample-cautions{margin-top:26px;border-left:3px solid var(--control);padding:5px 0 5px 20px}.sample-cautions>p{font-size:.8rem;max-width:90ch;margin:12px 0}.sample-cautions a{font-size:.7rem}</style>
