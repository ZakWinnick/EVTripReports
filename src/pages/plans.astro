---
import Base from '../layouts/Base.astro';
import SamplePreview from '../components/SamplePreview.astro';
import PhotoBand from '../components/PhotoBand.astro';
import { tiers, priceLabel } from '../data/plans.js';
import { titleCase } from '../lib/title-case.js';
const rows: [string, boolean, boolean, boolean][] = [
  ['Charging stops and backups, gaps flagged', true, true, true],
  ['Every stop checked with the network', true, true, true],
  ['Matched to your port, adapter, and memberships', true, true, true],
  ['Dated driver reports', true, true, true],
  ['Food and restroom notes', false, true, true],
  ['Lodging notes', false, true, true],
  ['Battery targets and charging strategy', false, true, true],
  ['Multiple days and overnight charging', false, false, true],
  ['Trip preferences and contingency notes', false, false, true],
];
const faq = [
  { q: 'How is this different from ABRP?', a: 'Keep ABRP for the drive. A plan is what you read before you leave: built for your port, adapter, and memberships, checked with each network, with backups and gaps flagged.' },
  { q: 'What if a charger is down when I get there?', a: 'Each stop lists a backup when we can verify one, and says so when we can’t. Check the network’s app before you arrive.' },
  { q: 'Does any charging network pay you?', a: 'No. If we add affiliate links for hotels or gear, they’ll be marked.' },
  { q: 'Which trips can you plan?', a: 'Any trip. Tell us your start, destination, and must-stops.' },
  { q: 'What do you need from me?', a: 'Your car, port and adapter, memberships, start, destination, and dates. Notes about kids, pets, or a favorite diner help.' },
  { q: 'When do I get my plan?', a: 'Route Plan and Detailed Plan within 48 hours. Multi-Day or Family within 3 business days. The clock starts once we have payment and your trip details.' },
  { q: 'Why the form before payment?', a: 'Stripe only records the payment. Your trip details come from the form, so we save those first.' },
];
---
<Base title="Plan an EV road trip" description="Get an EV trip plan for your car, adapter, and dates. Compare $19, $39, and $79 plans, see a sample, and tell us where you want to go.">
  <section class="band band--tight"><div class="wrap">
    <div id="plan-intro" class="sample-feature"><div><h1 class="h1">Let Us Plan Your EV Trip</h1><p class="lede" style="margin-top:22px">Built for your car, adapter, and dates. Checked stops, backups, and anything we couldn’t confirm.</p><p class="small muted" style="margin-top:18px">Reviewed by a person. Delivered in 48 hours, or 3 business days for multi-day trips.</p><div class="btnrow" style="margin-top:25px"><a class="pill pill--lg" href="#compare">Compare Plans</a><a class="text-link" href="/sample-plan/">Read the Sample Plan</a></div></div><SamplePreview /></div>
    <div id="checkout-return" class="checkout-return" hidden role="status"><h2 class="h2">Back from Checkout?</h2><p>This page cannot confirm a payment. Check for your Stripe receipt before paying again. If you sent your trip details first, you’re all set.</p><p>When your plan is ready, find it with your checkout email. Paid without sending details? Email us and we’ll match them.</p><div class="btnrow"><a class="pill" href="/find-my-plans/">Find My Plans</a><a class="text-link" href="mailto:support@evtripreports.com?subject=Trip%20order%20help">Get Order Help</a><a class="text-link" href="/plans/">Start a Different Trip</a></div></div>
  </div></section>

  <PhotoBand name="charging-hub" alt="Electric sedan at a fast-charging station at night" credit="YRKA PICTURED" href="https://unsplash.com/photos/a-blue-car-parked-in-front-of-a-gas-station-UUG01f0n_88" />

  <section id="compare" class="band band--tight band--mist">
    <div class="wrap">
      <h2 class="h2">Compare Plans</h2>
      <p class="lede" style="margin-top:12px">We save your details before opening checkout.</p>
      <div class="plan-cards">{tiers.map((t) => <article class:list={['plan-card', { 'plan-card--featured': t.id === 'detailed' }]}><h3 class="h3">{titleCase(t.name)}</h3><p class="plan-card__price">{t.price}<span> / trip</span></p><p class="small muted">{t.blurb}</p><p class="small">{t.delivery}</p><a class="pill pay-link" href="#request" data-tier={t.name}>Choose {titleCase(t.name)}</a></article>)}</div>
      <p class="small muted" style="margin-top:18px">Planned and reviewed by Zak Winnick.</p>
      <details class="plan-comparison"><summary>Compare Everything Included</summary>
      <div class="cmp" role="table" aria-label="Plan comparison">
        <div class="cmp__row cmp__hdr" role="row">
          <div role="columnheader"><span class="sr">Feature</span></div>
          {tiers.map((t) => (
            <div role="columnheader" class="cmp__tier">
              <span class="cmp__name">{titleCase(t.name)}</span>
              <span class="cmp__price">{priceLabel(t)}</span>
              <span class="small muted">{t.blurb}</span>

            </div>
          ))}
        </div>
        {rows.map(([label, a, b, c]) => (
          <div class="cmp__row" role="row">
            <div role="rowheader" class="cmp__label">{label}</div>
            {[a, b, c].map((v, i) => (
              <div role="cell" class="cmp__cell" data-tier={tiers[i].name}>
                {v ? <span class="yes" role="img" aria-label="Included"></span> : <span class="no" role="img" aria-label="Not included"></span>}
              </div>
            ))}
          </div>
        ))}
        <div class="cmp__row" role="row">
          <div role="rowheader" class="cmp__label">Delivery</div>
          {tiers.map((t) => <div role="cell" class="cmp__cell small" data-tier={t.name}>{t.delivery}</div>)}
        </div>
      </div></details><p class="small muted" style="margin-top:20px">Battery targets are estimates. Food, lodging, and backup notes depend on what we can source, and gaps are flagged. We don’t make bookings.</p>
    </div>
  </section>

  <section id="request" class="band band--tight">
    <div class="wrap req">
      <div>
        <h2 class="h2">Tell Us About Your Trip</h2>
        <p class="small muted" style="margin-top:8px">Planned and reviewed by Zak Winnick.</p>
        <p id="form-lede" class="lede" style="margin-top:14px">Route first, then the car. Payment comes last.</p>
      </div>
      <form id="intake" class="panel form" novalidate>
        <noscript><p>This form needs JavaScript for the spam check. Turn it on, or email <a href="mailto:support@evtripreports.com">support@evtripreports.com</a>.</p></noscript>
        <p class="form-step"><b>1</b>Your Route</p>
        <div class="grid2">
          <label>Starting from<input name="start" placeholder="Pasadena, CA" required /></label>
          <label>Going to<input name="end" placeholder="Las Vegas, NV" required /></label>
        </div>
        <div class="grid2">
          <label>Leaving<input name="depart" type="date" required /></label>
          <label>Coming back (optional)<input name="return" type="date" /></label>
        </div>
        <p class="small muted">Need a return trip? Say so in the notes.</p>
        <button class="pill pill--ghost route-check" type="button">Continue to Trip Details</button>
        <p class="route-check-message" role="status" aria-live="polite"></p>
        <div class="trip-more">
        <p class="form-step"><b>2</b>Your Car and Who’s Coming</p>
        <div class="grid2">
          <label>Your name<input name="name" autocomplete="name" required /></label>
          <label>Email<input name="email" type="email" autocomplete="email" required /></label>
        </div>
        <label>Plan<select name="tier" required>
          {tiers.map((t) => <option value={t.name}>{titleCase(t.name)}, {t.price}</option>)}
        </select></label>
        <div class="grid2">
          <label>Car (year, make, model, trim)<input name="car" placeholder="2024 Ioniq 5 SE AWD" required /></label>
          <label>Charge port and adapter<select name="port" required>
            <option value="">Choose one</option>
            <option>CCS port, no adapter</option>
            <option>CCS port, with a NACS adapter</option>
            <option>NACS port (Tesla-style)</option>
            <option>NACS port, with a CCS adapter</option>
            <option>Not sure</option>
          </select><span class="small muted">Not sure is fine. We’ll ask.</span></label>
        </div>
        <div class="grid2">
          <label>Leaving at (optional)<input name="departTime" type="time" /><span class="small muted">Local time where you start.</span></label>
          <label>Battery when you leave, % (optional)<input name="startBattery" type="number" inputmode="numeric" min="1" max="100" step="1" placeholder="80" /></label>
        </div>
        <label>Passengers<input name="passengers" placeholder="2 adults, 1 kid, 1 dog" /></label>
        <fieldset>
          <legend>Charging memberships</legend>
          <div class="checks">
            {['Tesla Supercharging membership', 'Electrify America Pass+', 'EVgo plan', 'Rivian Adventure Network', 'ChargePoint', 'None'].map((m) => (
              <label class="check"><input type="checkbox" name="memberships" value={m} /> {m}</label>
            ))}
          </div>
        </fieldset>
        <label>Anything else<textarea name="notes" rows="4" placeholder="Must-stops, hotels you like, how far you're comfortable driving in a day"></textarea></label>
        <label class="hp" aria-hidden="true">Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
        <div id="turnstile-slot" hidden></div>
        <p class="form-step"><b>3</b>Save Details and Pay</p>
        <div class="btnrow">
          <button class="pill pill--lg" type="submit">Save Details and Pay $19</button>
          <span class="small muted">By sending, you agree to the <a href="/terms/">terms</a> and <a href="/privacy/">privacy policy</a>.</span>
        </div>
        <p class="form__msg" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>


  <section class="band band--tight">
    <div class="wrap">
      <h2 class="h2">Questions</h2>
      <p class="lede" style="margin-top:12px">More on the <a href="/faq/">FAQ</a>.</p>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <h2 id="refunds" class="h2" style="margin-top:64px">Refund Policy</h2>
      <div class="prose" style="margin-top:16px">
        <ul>
          <li>If we miss the delivery time, you get a full refund.</li>
          <li>If a station fact in your plan was wrong on the date we checked it, you get a full refund.</li>
          <li>A plan that was correct on its check date isn’t refundable because a site changed later.</li>
          <li>Ask for a refund by replying to the email your plan came in, or by writing to <a href="mailto:support@evtripreports.com">support@evtripreports.com</a>, within 14 days of your trip.</li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<script is:inline id="plan-tiers" type="application/json" set:html={JSON.stringify(tiers.map((t) => ({ id: t.id, name: t.name, price: t.price, delivery: t.delivery, stripeUrl: t.stripeUrl })))}></script>
<script>
  import { loadTurnstile, renderWidget, SECURITY_RETRY } from '../lib/turnstile-client.js';
  import { corridorBySlug } from '../lib/corridors.js';

  const form = document.getElementById('intake') as HTMLFormElement | null;
  const msg = form?.querySelector('.form__msg') as HTMLElement | null;
  const slot = document.getElementById('turnstile-slot');
  let widget: { getToken: () => string; reset: () => void } | null = null;

  async function setupTurnstile() {
    if (!slot) return;
    try {
      const res = await fetch('/api/intake');
      if (!res.ok) return;
      const body = await res.json();
      const sitekey = body.turnstileSiteKey;
      if (!sitekey) return;
      await loadTurnstile();
      widget = renderWidget(slot, { sitekey, action: 'plan_request' });
    } catch {
      widget = null;
    }
  }
  setupTurnstile();

  const params = new URLSearchParams(location.search);
  const returning = params.get('paid') === '1';
  const thanks = document.getElementById('checkout-return');
  const planTiers = tiersJson();
  const submitBtn = form?.querySelector('button[type=submit]') as HTMLButtonElement | null;

  function tiersJson(): { id: string; name: string; price: string; delivery: string; stripeUrl: string }[] {
    return JSON.parse(document.getElementById('plan-tiers')?.textContent || '[]');
  }

  function selectedTier() {
    const name = (form?.querySelector('[name=tier]') as HTMLSelectElement | null)?.value;
    return planTiers.find((t) => t.name === name) || planTiers[0];
  }

  function payLabel() {
    const tier = selectedTier();
    if (!tier) return 'Save Details and Pay';
    return `Save Details and Pay ${tier.price}`;
  }

  // A URL parameter is never evidence of payment. Prevent accidental duplicate orders.
  if (returning) {
    thanks?.removeAttribute('hidden');
    document.querySelectorAll('#plan-intro, #compare, #request').forEach((el) => el.setAttribute('hidden', ''));
    thanks?.scrollIntoView({ block: 'center' });
  }
  const routeField = (name: string) => form?.querySelector(`[name="${name}"]`) as HTMLInputElement | null;
  const routeMessage = form?.querySelector('.route-check-message') as HTMLElement | null;
  const more = form?.querySelector('.trip-more') as HTMLElement | null;
  const checkButton = form?.querySelector('.route-check') as HTMLButtonElement | null;
  let routeConfirmed = false;
  if (more) more.hidden = true;
  const checkRoute = () => {
    const start = routeField('start');
    const end = routeField('end');
    const depart = routeField('depart');
    const back = routeField('return');
    if (!start || !end || !depart || !routeMessage) return false;
    const tier = selectedTier();
    const departure = depart.value ? new Date(`${depart.value}T23:59:59`) : null;
    const lead = new Date();
    if (tier?.name === 'Multi-day or family') {
      let days = 0;
      while (days < 3) { lead.setDate(lead.getDate() + 1); if (![0, 6].includes(lead.getDay())) days++; }
    } else lead.setHours(lead.getHours() + 48);
    let error = '';
    if (!start.value.trim() || !end.value.trim()) error = 'Enter a start and destination.';
    else if (!departure || Number.isNaN(departure.getTime())) error = 'Choose a departure date.';
    else if (departure <= lead) error = 'That departure is too close for this plan’s delivery time. Email support@evtripreports.com before paying.';
    else if (back?.value && back.value < depart.value) error = 'The return date must be on or after your departure.';
    routeConfirmed = !error;
    if (more) more.hidden = !routeConfirmed;
    routeMessage.textContent = error || 'Next, tell us about your car and any places you want to visit.';
    routeMessage.classList.toggle('is-err', !!error);
    if (checkButton) checkButton.textContent = error ? 'Continue to Trip Details' : 'Trip Details Are Below';
    return routeConfirmed;
  };
  checkButton?.addEventListener('click', () => { if (checkRoute()) routeField('name')?.focus(); });
  ['start', 'end', 'depart', 'return'].forEach((name) => routeField(name)?.addEventListener('input', () => {
    routeConfirmed = false;
    if (more) more.hidden = true;
    if (routeMessage) routeMessage.textContent = '';
    if (checkButton) checkButton.textContent = 'Continue to Trip Details';
  }));
  const chosenRoute = corridorBySlug(params.get('route') || '');
  if (chosenRoute) {
    const start = routeField('start'), end = routeField('end');
    if (start) start.value = chosenRoute.from.label;
    if (end) end.value = chosenRoute.to.label;
  }
  const requestedTier = planTiers.find((tier) => tier.id === params.get('tier'));
  const tierSelect = form?.querySelector('[name=tier]') as HTMLSelectElement | null;
  if (requestedTier && tierSelect && !returning) tierSelect.value = requestedTier.name;
  if (submitBtn) submitBtn.textContent = payLabel();
  form?.querySelector('[name=tier]')?.addEventListener('change', () => {
    if (submitBtn) submitBtn.textContent = payLabel();
    if (routeConfirmed) checkRoute();
  });

  document.querySelectorAll('a.pay-link').forEach((el) => {
    el.addEventListener('click', () => {
      const name = el.getAttribute('data-tier');
      const select = form?.querySelector('[name=tier]') as HTMLSelectElement | null;
      if (!select || !name) return;
      if (![...select.options].some((option) => option.value === name)) return;
      select.value = name;
      select.dispatchEvent(new Event('change'));
      if (routeConfirmed) checkRoute();
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !msg || returning) return;
    if (!checkRoute()) { checkButton?.focus(); return; }
    msg.className = 'form__msg';
    if (!form.checkValidity()) {
      const bad = form.querySelector(':invalid') as HTMLInputElement | null;
      msg.textContent = 'Fill in the required fields: name, email, car, port, start, destination, and departure date.';
      msg.classList.add('is-err');
      bad?.focus();
      return;
    }
    const fd = new FormData(form);
    const data: Record<string, unknown> = Object.fromEntries(fd.entries());
    data.memberships = fd.getAll('memberships');
    if (widget && !widget.getToken()) {
      msg.textContent = SECURITY_RETRY;
      msg.classList.add('is-err');
      widget.reset();
      return;
    }
    if (widget) data['cf-turnstile-response'] = widget.getToken();
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const tier = selectedTier();
    btn.disabled = true;
    btn.textContent = 'Sending';
    try {
      const res = await fetch('/api/intake', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) });
      if (res.ok) {
        if (tier?.stripeUrl) {
          const next = new URL(tier.stripeUrl);
          if (data.email) next.searchParams.set('prefilled_email', String(data.email));
          // The order reference comes back on the Stripe payment so the webhook can match it to this request.
          const saved = await res.clone().json().catch(() => ({}));
          if (saved && typeof saved.ref === 'string' && /^etr-[1-9]\d{0,14}$/.test(saved.ref)) next.searchParams.set('client_reference_id', saved.ref);
          window.location.href = next.toString();
          return;
        }
        form.reset();
        msg.textContent = 'Trip details saved. Checkout could not be opened. Contact support@evtripreports.com before paying.';
        msg.classList.add('is-ok');
      } else if (res.status === 403) {
        msg.textContent = SECURITY_RETRY;
        msg.classList.add('is-err');
      } else if (res.status === 503 || res.status === 404 || res.status === 405) {
        msg.textContent = 'Plan requests are not open yet. Check back soon.';
        msg.classList.add('is-err');
      } else {
        const body = await res.json().catch(() => ({}));
        msg.textContent = body.error || 'Your request did not go through. Check the fields and try again.';
        msg.classList.add('is-err');
      }
    } catch {
      msg.textContent = 'Your request did not go through because the connection dropped. Try again.';
      msg.classList.add('is-err');
    } finally {
      if (tier?.stripeUrl && msg.classList.contains('is-ok')) return;
      btn.disabled = false;
      btn.textContent = payLabel();
      if (widget) widget.reset();
    }
  });
</script>

<style>
  .plan-cards { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; margin-top:30px; }
  .plan-card { background:var(--white); padding:26px; border:1px solid var(--line-strong); border-top:4px solid var(--ink); border-radius:var(--radius); display:flex; flex-direction:column; gap:4px; }
  .plan-card--featured { border-top-color:var(--sign); box-shadow:0 0 0 1px var(--sign); }
  .plan-card__price { font-size:3rem; font-weight:800; letter-spacing:-.02em; line-height:1; margin:14px 0 12px; font-variant-numeric:tabular-nums; }
  .plan-card__price span { font-size:.9rem; font-weight:600; color:var(--ink-2); letter-spacing:0; }
  .plan-card:not(.plan-card--featured) .pay-link { background:var(--white); color:var(--ink); box-shadow:inset 0 0 0 1.5px var(--control); }
  .plan-card:not(.plan-card--featured) .pay-link:hover { background:var(--mist); box-shadow:inset 0 0 0 1.5px var(--ink); }
  .plan-card .pay-link { margin-top:auto; align-self:stretch; }
  .plan-card .small { font-size:.92rem; margin-bottom:6px; }
  .plan-card .pay-link { margin-top:auto; }
  .plan-comparison { margin-top:28px; border-top:1px solid var(--line-strong); border-bottom:1px solid var(--line-strong); padding:14px 0; }
  .trip-more { display:grid; gap:16px; border-top:1px solid var(--line); padding-top:22px; margin-top:6px; }
  .route-check { justify-self:start; }
  .route-check-message { font-size:.92rem; margin:0; }
  @media(max-width:760px) { .plan-cards{grid-template-columns:1fr;} .plan-card{padding:24px;} .plan-card__price{font-size:3rem;} }

  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .cmp { margin-top: 32px; }
  .cmp__row { display: grid; grid-template-columns: 1.4fr repeat(3, 1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); align-items: center; }
  .cmp__hdr { border-bottom: 2px solid var(--ink); align-items: end; padding-bottom: 20px; }
  .cmp__tier { display: flex; flex-direction: column; gap: 4px; }
  .cmp__name { font-weight: 800; }
  .pay-link { margin-top: 10px; align-self: flex-start; }
  .cmp__price { font-size: clamp(1.8rem, 3.4vw, 2.4rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1; font-variant-numeric: tabular-nums; }
  .cmp__label { color: var(--ink); }
  .yes { display: inline-block; width: 14px; height: 8px; border-left: 3px solid var(--sign); border-bottom: 3px solid var(--sign); transform: rotate(-45deg) translate(2px, -2px); }
  .no { display: inline-block; width: 14px; height: 2px; background: var(--line-strong); vertical-align: middle; }
  @media (max-width: 760px) {
    .cmp__row { grid-template-columns: 1fr 1fr 1fr; }
    .cmp__hdr > div:first-child { display: none; }
    .cmp__label { grid-column: 1 / -1; font-weight: 600; font-size: 0.94rem; }
    .cmp__price { font-size: 1.6rem; }
    .cmp__tier .small { display: none; }
  }
  .req { display: grid; grid-template-columns: 1fr 1.6fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  @media (max-width: 860px) { .req { grid-template-columns: 1fr; } }
  .form { padding: clamp(18px, 3vw, 32px); display: grid; gap: 16px; }
  .form label { display: grid; gap: 6px; font-size: 0.97rem; font-weight: 700; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 560px) { .grid2 { grid-template-columns: 1fr; } }
  .form input, .form select, .form textarea { font: inherit; font-size: 1rem; font-weight: 400; color: var(--ink); background: #fff; border: 1.5px solid var(--control); border-radius: var(--radius); padding: 10px 12px; width: 100%; }
  .form input:focus, .form select:focus, .form textarea:focus { outline: 3px solid var(--sign); outline-offset: 0; border-color: var(--green); }
  fieldset { border: 0; padding: 0; margin: 0; }
  legend { font-size: 0.97rem; font-weight: 700; margin-bottom: 8px; }
  .checks { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; }
  @media (max-width: 560px) { .checks { grid-template-columns: 1fr; } }
  .form .check { display: flex; gap: 10px; align-items: center; font-weight: 400; }
  .form .check input { width: 18px; height: 18px; accent-color: var(--green); }
  .hp { position: absolute; left: -9999px; }
  .form__msg { margin: 0; font-weight: 500; }
  .form__msg.is-ok { color: var(--green); }
  .form__msg.is-err, .route-check-message.is-err { color: var(--stop); }
  .sample { list-style: none; counter-reset: s; margin: 28px 0 0; padding: clamp(18px, 3vw, 28px); }
  .sample li { counter-increment: s; display: grid; grid-template-columns: 40px 1fr; column-gap: 12px; row-gap: 4px; padding: 14px 0; border-top: 1px solid var(--line); }
  .sample li:first-child { border-top: 0; padding-top: 0; }
