---
import Base from '../layouts/Base.astro';
import { tiers, priceLabel } from '../data/plans.js';
const rows: [string, boolean, boolean, boolean][] = [
  ['Primary charger and backup at every stop', true, true, true],
  ['Every stop re-checked against the network before delivery', true, true, true],
  ['Built for your port, adapter, and memberships', true, true, true],
  ['Recent driver reports for each stop', true, true, true],
  ['Food and restrooms at each stop', false, true, true],
  ['Hotels with chargers', false, true, true],
  ['Multiple days and overnight charging', false, false, true],
  ['Stops timed for meals and bathroom breaks', false, false, true],
];
const faq = [
  { q: 'How is this different from ABRP?', a: 'A Better Routeplanner is the right tool for battery math and routing, and you should keep it for the drive. A plan is what you read before you leave. It is built for your port, adapter, and memberships, checked against each network\'s own locator, with a backup at every stop.' },
  { q: 'What if a charger is down when I get there?', a: 'Every stop in your plan has a backup, and we tell you how far it is. We also flag sites where drivers have recently reported broken stalls, so you can plan to arrive with extra range.' },
  { q: 'Does any charging network pay you?', a: 'No. No network pays for placement or coverage. If we ever add affiliate links for hotels or gear, they will be marked on the page.' },
  { q: 'What do you need from me?', a: 'Your car, its charge port and any adapter you carry, your charging memberships, where you\'re starting and ending, and your dates. Notes about kids, pets, or a must-stop diner help too.' },
  { q: 'When do I get my plan?', a: 'Route and detailed plans within 48 hours. Multi-day and family plans within 3 business days. The clock starts when we have both the payment and the trip form. A person reviews the plan before it is sent.' },
  { q: 'Why the form before payment?', a: 'The Stripe page records the charge. It does not record your car, adapter, route, or dates. Send those first. Checkout then opens for the plan you picked, and Stripe brings you back here.' },
];
---
<Base title="Plan an EV road trip" description="A plan for your car, adapter, memberships, and dates. Stops that work for your car, a backup at each, and on detailed plans a place to eat or sleep while you charge. A person reviews it before you get it.">
  <section class="band band--tight">
    <div class="wrap">
      <h1 class="h1">We'll plan<br />the trip.</h1>
      <p class="lede" style="margin-top:20px">Send the car, the adapter, the memberships, and the dates. You get stops that work for that car, with a backup at every stop. Detailed plans add food, restrooms, and a hotel with a charger. We recommend them. We don't book the hotel, the rental, or a ticket. A person reviews every plan before it is sent. Route and detailed plans within 48 hours. Multi-day and family plans within 3 business days.</p>
      <div id="paid-thanks" class="note" hidden>
        <h2 class="h2">Payment received.</h2>
        <p style="margin:12px 0 0">Thanks. If the trip form is already in, a person reviews the plan and it goes out on that tier's delivery time. If you paid before sending the form, use it below. The receipt doesn't include your car, route, or dates.</p>
        <p style="margin:12px 0 0">When the plan is approved, open <a href="/find-my-plans">Find my plans</a> and use the email from checkout. We email a link that works once.</p>
      </div>
      <p class="note" style="margin-top:28px">Send the trip details, then pay. A plan is $19, $39, or $79. After payment, Stripe returns you to this page.</p>
    </div>
  </section>

  <section id="compare" class="band band--tight band--mist">
    <div class="wrap">
      <h2 class="h2">Compare plans</h2>
      <p class="lede" style="margin-top:12px">Each pay button opens that plan's Stripe checkout. Send the form first so we have the trip, then come back here from Stripe.</p>
      <div class="cmp" role="table" aria-label="Plan comparison">
        <div class="cmp__row cmp__hdr" role="row">
          <div role="columnheader"><span class="sr">Feature</span></div>
          {tiers.map((t) => (
            <div role="columnheader" class="cmp__tier">
              <span class="cmp__name">{t.name}</span>
              <span class="cmp__price">{priceLabel(t)}</span>
              <span class="small muted">{t.blurb}</span>
              <a class="pill pay-link" href={t.stripeUrl}>Pay {t.price}</a>
            </div>
          ))}
        </div>
        {rows.map(([label, a, b, c]) => (
          <div class="cmp__row" role="row">
            <div role="rowheader" class="cmp__label">{label}</div>
            {[a, b, c].map((v, i) => (
              <div role="cell" class="cmp__cell" data-tier={tiers[i].name}>
                {v ? <span class="yes" aria-label="Included"></span> : <span class="no" aria-label="Not included"></span>}
              </div>
            ))}
          </div>
        ))}
        <div class="cmp__row" role="row">
          <div role="rowheader" class="cmp__label">Delivery</div>
          {tiers.map((t) => <div role="cell" class="cmp__cell small" data-tier={t.name}>{t.delivery}</div>)}
        </div>
      </div>
    </div>
  </section>

  <section id="request" class="band band--tight">
    <div class="wrap req">
      <div>
        <h2 class="h2">Trip details</h2>
        <p id="form-lede" class="lede" style="margin-top:14px">This is step one. We save it, then open checkout for the plan you chose. A person reviews the plan before it is sent. Route and detailed plans within 48 hours. Multi-day and family plans within 3 business days.</p>
      </div>
      <form id="intake" class="panel form" novalidate>
        <div class="grid2">
          <label>Your name<input name="name" autocomplete="name" required /></label>
          <label>Email<input name="email" type="email" autocomplete="email" required /></label>
        </div>
        <label>Plan<select name="tier" required>
          {tiers.map((t) => <option value={t.name}>{t.name}, {t.price}</option>)}
        </select></label>
        <div class="grid2">
          <label>Car (year, make, model, trim)<input name="car" placeholder="2024 Ioniq 5 SE AWD" required /></label>
          <label>Charge port and adapter<select name="port" required>
            <option value="">Choose one</option>
            <option>CCS port, no adapter</option>
            <option>CCS port, with a NACS adapter</option>
            <option>NACS port (Tesla-style)</option>
            <option>NACS port, with a CCS adapter</option>
            <option>Not sure</option>
          </select></label>
        </div>
        <div class="grid2">
          <label>Starting from<input name="start" placeholder="Pasadena, CA" required /></label>
          <label>Going to<input name="end" placeholder="Las Vegas, NV" required /></label>
        </div>
        <div class="grid2">
          <label>Leaving<input name="depart" type="date" required /></label>
          <label>Coming back (optional)<input name="return" type="date" /></label>
        </div>
        <label>Passengers<input name="passengers" placeholder="2 adults, 1 kid, 1 dog" /></label>
        <fieldset>
          <legend>Charging memberships</legend>
          <div class="checks">
            {['Tesla Supercharging membership', 'Electrify America Pass+', 'EVgo plan', 'Rivian Adventure Network', 'ChargePoint', 'None'].map((m) => (
              <label class="check"><input type="checkbox" name="memberships" value={m} /> {m}</label>
            ))}
          </div>
        </fieldset>
        <label>Anything else<textarea name="notes" rows="4" placeholder="Must-stops, hotels you like, how far you're comfortable driving in a day"></textarea></label>
        <label class="hp" aria-hidden="true">Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
        <div id="turnstile-slot" hidden></div>
        <div class="btnrow">
          <button class="pill pill--lg" type="submit">Save details and pay $19</button>
          <span class="small muted">By sending, you agree to the <a href="/terms">terms</a> and <a href="/privacy">privacy policy</a>.</span>
        </div>
        <p class="form__msg" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="band band--tight band--mist">
    <div class="wrap">
      <h2 class="h2">What a plan looks like</h2>
      <p class="lede" style="margin-top:12px">An excerpt. Example driver: CCS car carrying a NACS adapter, LA to Las Vegas on a Saturday morning. Station facts are from our {`October 14, 2026`} check.</p>
      <ol class="sample panel">
        <li>
          <strong>Barstow, Tesla 1503 East Main Street</strong>
          <span>120 stalls, up to 325 kW, open to your car with the adapter. Non-Tesla price $0.64/kWh at our check.</span>
          <span class="muted">Backup: Electrify America at Walmart Barstow, 7 stalls at 350 kW plus one at 150 kW, no adapter needed.</span>
        </li>
        <li>
          <strong>Baker, Tesla Mojave Pointe Road</strong>
          <span>40 stalls, up to 325 kW, open to your car with the adapter. Drivers in May 2026 reported queues and broken units at the Electrify America site in town, so this is the primary.</span>
          <span class="muted">Backup: Electrify America, Ultra Gas and Mart, 12 stalls at 350 kW. Skip the Shell Supercharger in Baker: Tesla only.</span>
        </li>
        <li>
          <strong>Jean, Tesla at Terrible's</strong>
          <span>Top-off before Las Vegas traffic. 64 stalls, up to 325 kW, open to your car with the adapter.</span>
          <span class="muted">Backup: Electrify America at Prizm Outlets, Primm, 6 stalls at 350 kW.</span>
        </li>
      </ol>
      <p class="small muted" style="margin-top:12px">Your plan adds the target charge to leave each stop with, based on your car.</p>
    </div>
  </section>

  <section class="band band--tight">
    <div class="wrap">
      <h2 class="h2">Questions</h2>
      <p class="lede" style="margin-top:12px">More answers are on the <a href="/faq">FAQ</a>, including why this is different from your car's navigation.</p>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <h2 id="refunds" class="h2" style="margin-top:64px">Refund policy</h2>
      <div class="prose" style="margin-top:16px">
        <ul>
          <li>If we miss the delivery time, you get a full refund.</li>
          <li>If a station fact in your plan was wrong on the date we checked it, you get a full refund.</li>
          <li>Networks change things after we check. A plan that was correct on its check date isn't refundable because a site changed later.</li>
          <li>Ask for a refund by replying to the email your plan came in, within 14 days of your trip.</li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<script is:inline id="plan-tiers" type="application/json" set:html={JSON.stringify(tiers.map((t) => ({ name: t.name, price: t.price, delivery: t.delivery, stripeUrl: t.stripeUrl })))}></script>
<script>
  const form = document.getElementById('intake') as HTMLFormElement | null;
  const msg = form?.querySelector('.form__msg') as HTMLElement | null;
  const slot = document.getElementById('turnstile-slot');
  let widgetId: string | null = null;

  function loadTurnstile() {
    return new Promise<void>((resolve, reject) => {
      const w = window as unknown as { turnstile?: { render: Function; getResponse: Function; reset: Function } };
      if (w.turnstile) { resolve(); return; }
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('turnstile'));
      document.head.appendChild(s);
    });
  }

  async function setupTurnstile() {
    if (!slot) return;
    try {
      const res = await fetch('/api/intake');
      if (!res.ok) return;
      const body = await res.json();
      const sitekey = body.turnstileSiteKey;
      if (!sitekey) return;
      await loadTurnstile();
      const turnstile = (window as unknown as { turnstile: { render: Function } }).turnstile;
      slot.hidden = false;
      widgetId = turnstile.render(slot, { sitekey, action: 'plan_request' });
    } catch {
      widgetId = null;
    }
  }
  setupTurnstile();

  const paid = new URLSearchParams(location.search).get('paid') === '1';
  const thanks = document.getElementById('paid-thanks');
  const formLede = document.getElementById('form-lede');
  const planTiers = tiersJson();
  const submitBtn = form?.querySelector('button[type=submit]') as HTMLButtonElement | null;

  function tiersJson(): { name: string; price: string; delivery: string; stripeUrl: string }[] {
    return JSON.parse(document.getElementById('plan-tiers')?.textContent || '[]');
  }

  function selectedTier() {
    const name = (form?.querySelector('[name=tier]') as HTMLSelectElement | null)?.value;
    return planTiers.find((t) => t.name === name) || planTiers[0];
  }

  function payLabel() {
    const tier = selectedTier();
    if (!tier) return 'Save details and pay';
    return paid ? 'Send trip details' : `Save details and pay ${tier.price}`;
  }

  if (paid) {
    thanks?.removeAttribute('hidden');
    document.querySelectorAll('.pay-link').forEach((el) => el.setAttribute('hidden', ''));
    if (formLede) formLede.textContent = 'Payment is in. Send the trip details if you have not already. Route and detailed plans within 48 hours. Multi-day and family plans within 3 business days.';
  }
  if (submitBtn) submitBtn.textContent = payLabel();
  form?.querySelector('[name=tier]')?.addEventListener('change', () => {
    if (submitBtn) submitBtn.textContent = payLabel();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !msg) return;
    msg.className = 'form__msg';
    if (!form.checkValidity()) {
      const bad = form.querySelector(':invalid') as HTMLInputElement | null;
      msg.textContent = 'Fill in the required fields: name, email, car, port, start, destination, and departure date.';
      msg.classList.add('is-err');
      bad?.focus();
      return;
    }
    const fd = new FormData(form);
    const data: Record<string, unknown> = Object.fromEntries(fd.entries());
    data.memberships = fd.getAll('memberships');
    const turnstile = (window as unknown as { turnstile?: { getResponse: (id: string) => string; reset: (id: string) => void } }).turnstile;
    if (widgetId && turnstile) data['cf-turnstile-response'] = turnstile.getResponse(widgetId);
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const tier = selectedTier();
    btn.disabled = true;
    btn.textContent = 'Sending';
    try {
      const res = await fetch('/api/intake', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) });
      if (res.ok) {
        if (!paid && tier?.stripeUrl) {
          const next = new URL(tier.stripeUrl);
          if (data.email) next.searchParams.set('prefilled_email', String(data.email));
          window.location.href = next.toString();
          return;
        }
        form.reset();
        msg.textContent = tier?.delivery ? `Trip details received. Delivery: ${tier.delivery}.` : 'Trip details received.';
        msg.classList.add('is-ok');
      } else if (res.status === 503 || res.status === 404 || res.status === 405) {
        msg.textContent = 'Plan requests are not open yet. Check back soon.';
        msg.classList.add('is-err');
      } else {
        const body = await res.json().catch(() => ({}));
        msg.textContent = body.error || 'Your request did not go through. Check the fields and try again.';
        msg.classList.add('is-err');
      }
    } catch {
      msg.textContent = 'Your request did not go through because the connection dropped. Try again.';
      msg.classList.add('is-err');
    } finally {
      if (!paid && tier?.stripeUrl && msg.classList.contains('is-ok')) return;
      btn.disabled = false;
      btn.textContent = payLabel();
      if (widgetId && turnstile) turnstile.reset(widgetId);
    }
  });
</script>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .cmp { margin-top: 32px; }
  .cmp__row { display: grid; grid-template-columns: 1.4fr repeat(3, 1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); align-items: center; }
  .cmp__hdr { border-bottom: 1px solid var(--ink); align-items: end; padding-bottom: 20px; }
  .cmp__tier { display: flex; flex-direction: column; gap: 4px; }
  .cmp__name { font-weight: 700; letter-spacing: -0.02em; }
  .pay-link { margin-top: 10px; align-self: flex-start; }
  .cmp__price { font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; letter-spacing: -0.05em; line-height: 1; font-variant-numeric: tabular-nums; }
  .cmp__label { color: var(--ink); }
  .yes { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--green); }
  .no { display: inline-block; width: 14px; height: 2px; background: var(--line-strong); vertical-align: middle; }
  @media (max-width: 760px) {
    .cmp__row { grid-template-columns: 1fr 1fr 1fr; }
    .cmp__hdr > div:first-child { display: none; }
    .cmp__label { grid-column: 1 / -1; font-weight: 600; font-size: 0.94rem; }
    .cmp__price { font-size: 1.6rem; }
    .cmp__tier .small { display: none; }
  }
  .req { display: grid; grid-template-columns: 1fr 1.6fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  @media (max-width: 860px) { .req { grid-template-columns: 1fr; } }
  .form { padding: clamp(18px, 3vw, 32px); display: grid; gap: 16px; }
  .form label { display: grid; gap: 6px; font-size: 0.94rem; font-weight: 500; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 560px) { .grid2 { grid-template-columns: 1fr; } }
  .form input, .form select, .form textarea { font: inherit; font-size: 1rem; font-weight: 400; color: var(--ink); background: #fff; border: 1px solid var(--line-strong); border-radius: 10px; padding: 11px 12px; width: 100%; }
  .form input:focus, .form select:focus, .form textarea:focus { outline: 2px solid var(--green); outline-offset: 0; border-color: var(--green); }
  fieldset { border: 0; padding: 0; margin: 0; }
  legend { font-size: 0.94rem; font-weight: 500; margin-bottom: 8px; }
  .checks { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; }
  @media (max-width: 560px) { .checks { grid-template-columns: 1fr; } }
  .form .check { display: flex; gap: 10px; align-items: center; font-weight: 400; }
  .form .check input { width: 18px; height: 18px; accent-color: var(--green); }
  .hp { position: absolute; left: -9999px; }
  .form__msg { margin: 0; font-weight: 500; }
  .form__msg.is-ok { color: var(--green); }
  .form__msg.is-err { color: #8a1f11; }
  .sample { list-style: none; counter-reset: s; margin: 28px 0 0; padding: clamp(18px, 3vw, 28px); }
  .sample li { counter-increment: s; display: grid; grid-template-columns: 40px 1fr; column-gap: 12px; row-gap: 4px; padding: 14px 0; border-top: 1px solid var(--line); }
  .sample li:first-child { border-top: 0; padding-top: 0; }
  .sample li::before { content: counter(s); grid-row: span 3; width: 30px; height: 30px; border-radius: 50%; background: var(--green); color: #fff; font-weight: 700; display: grid; place-items: center; font-size: 0.9rem; }
  .sample li > * { grid-column: 2; }
  .faq { margin-top: 24px; border-top: 1px solid var(--ink); max-width: 820px; }
  .faq details { border-bottom: 1px solid var(--line); padding: 18px 0; }
  .faq summary { cursor: pointer; font-weight: 600; font-size: 1.1rem; letter-spacing: -0.02em; }
  .faq p { margin: 12px 0 0; color: var(--ink-2); }
</style>
