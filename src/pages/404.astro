---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page is not on EV Trip Reports.">
  <section class="band">
    <div class="wrap">
      <h1 class="h1">That page isn't here.</h1>
      <p class="lede" style="margin-top:20px">This address doesn't match a published guide. Routes that are still being checked are not linked.</p>
      <div class="btnrow" style="margin-top:28px">
        <a class="pill pill--lg" href="/">Back to the guides</a>
        <a class="pill pill--lg pill--ghost" href="/plans">Plan a trip</a>
      </div>
    </div>
  </section>
</Base>
