---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page is not on EV Trip Reports." noindex={true}>
  <section class="band">
    <div class="wrap">
      <h1 class="h1">No stop here.</h1>
      <p class="lede" style="margin-top:20px">That page isn't available. Tell us where you want to go and we can help plan your trip.</p>
      <div class="btnrow" style="margin-top:28px"><a class="pill pill--lg" href="/plans/">Plan my trip</a></div>
    </div>
  </section>
</Base>
