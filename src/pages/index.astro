---
import Base from '../layouts/Base.astro';
import { routeLine, statStrip, guideCards } from '../lib/render-guide.js';
import { visibleHomeRoutes } from '../lib/publish-status.js';
import featured from '../data/routes/la-to-las-vegas.json';
import routes from '../data/routes.json';
import { tiers, priceLabel } from '../data/plans.js';

const routeFiles = import.meta.glob('../data/routes/*.json', { eager: true });
const routeBySlug = Object.fromEntries(Object.values(routeFiles).map((m) => {
  const route = (m as { default?: { slug: string; stops: unknown[] } }).default ?? (m as { slug: string; stops: unknown[] });
  return [route.slug, route];
}));

const cards = visibleHomeRoutes(routes, routeBySlug);
const checkedLabel = new Date(featured.checked + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const homeLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'EV Trip Reports',
      url: 'https://evtripreports.com/',
      description: 'A travel agent for EVs.',
    },
    {
      '@type': 'Organization',
      name: 'EV Trip Reports',
      url: 'https://evtripreports.com/',
      description: 'A travel agent for EVs.',
    },
  ],
};
---
<Base title="A travel agent for EVs" description="A travel agent for EV road trips. Stops that work for your car, a backup for each, and a place to eat or sleep while you charge.">
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(homeLd)}></script>
  <section class="band hero">
    <div class="wrap">
      <h1 class="display">A travel agent<br />for EVs.</h1>
      <p class="lede" style="margin-top:28px">Tell us where you're going and what you drive. We plan the trip around charging: stops that work for your car, a backup for each, and on a detailed plan a place to eat or sleep while you charge. Free guides cover the corridors we publish. We don't book the hotel, the rental, or the ticket.</p>
      <div class="btnrow" style="margin-top:32px">
        <a class="pill pill--lg" href="/guides/la-to-las-vegas/">Read the LA to Las Vegas guide</a>
        <a class="pill pill--lg pill--ghost" href="/plans/">Get a plan for your car</a>
      </div>
    </div>
  </section>

  <section class="band band--mist">
    <div class="wrap">
      <div class="feat__head">
        <div>
          <p class="muted" style="margin:0 0 8px">Featured route, {featured.highway}</p>
          <h2 class="h2">{featured.title}</h2>
        </div>
        <p class="small muted" style="margin:0">Checked {checkedLabel}</p>
      </div>
      <div class="panel" id="featured-route" style="padding: clamp(18px, 3vw, 32px); margin-top: 28px">
        <Fragment set:html={routeLine(featured, '/guides/la-to-las-vegas/')} />
      </div>
      <div id="featured-stats" style="margin-top: 40px"><Fragment set:html={statStrip(featured.stats)} /></div>
    </div>
  </section>

  <section id="guides" class="band">
    <div class="wrap">
      <h2 class="h2">Route guides</h2>
      <p class="lede" style="margin-top:12px">A guide is linked once the primary charger at every stop has been checked on the network's locator. Unconfirmed facts stay labeled on the page.</p>
      <ul class="guides" id="guides-list"><Fragment set:html={guideCards(cards)} /></ul>
    </div>
  </section>

  <section class="band band--mist">
    <div class="wrap plans">
      <div>
        <h2 class="h2">A plan for your car and your dates.</h2>
        <p class="lede" style="margin-top:16px">A paid plan uses your car, charge port, adapter, memberships, and dates. Every charging fact comes from the network's own site, with the date we checked it. A person reviews the plan before it is sent. Route and detailed plans within 48 hours. Multi-day plans within 3 business days.</p>
        <div class="btnrow" style="margin-top:28px">
          <a class="pill pill--lg" href="/plans/#request">Plan my trip</a>
          <a class="pill pill--lg pill--ghost" href="/plans/">Compare plans</a>
        </div>
      </div>
      <dl class="tiers">
        {tiers.map((t) => (
          <div>
            <dt>{t.name}</dt>
            <dd><a href="/plans/#compare">{priceLabel(t)}</a></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="band">
    <div class="wrap method">
      <h2 class="h2">Where the numbers come from</h2>
      <ol class="sources">
        <li><strong>The network's own locator.</strong> Tesla, Electrify America, EVgo and the rest decide stall count, kW, access, and price.</li>
        <li><strong>The DOE station database.</strong> We pull every DC fast site in each stop town so nothing gets missed.</li>
        <li><strong>Driver reports.</strong> PlugShare, X, Reddit, and forums, each with a link and a date. A report stays a report. It is not a confirmed stall count or access flag.</li>
      </ol>
      <p class="muted" style="margin-top:20px">Third-party aggregators are leads, never the source. When sources disagree, we show both. <a href="/methodology/">Full methodology</a></p>
    </div>
  </section>
</Base>
