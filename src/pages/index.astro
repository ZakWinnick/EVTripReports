---
// Home: one sample trip told the way the road tells it. A guide sign for the
// destination, then a strip map of the corridor beside the stop that matters.
import Base from '../layouts/Base.astro';
import PhotoBand from '../components/PhotoBand.astro';
import '../styles/trip-home.css';
import route from '../data/routes/la-to-las-vegas.json';
import { samplePlan } from '../lib/sample-plan.js';
import { fmtDate } from '../lib/render-guide.js';
import { tiers } from '../data/plans.js';
import { titleCase } from '../lib/title-case.js';
const plan = samplePlan(route);
const stop = plan.stops.find((s: any) => s.charging);
const strategy = plan.strategy.stops.find((s: any) => s.stopId === stop.id);
const backup = stop.backups[0];
const total = Number(route.stats[0].value);
const destination = plan.strategy.destination;
const signRows = [
  { name: 'Barstow', mile: plan.stops.find((s: any) => s.id === 'barstow')?.mile, charge: false },
  { name: stop.name, mile: stop.mile, charge: true },
  { name: 'Las Vegas', mile: total, charge: false },
];
const at = (mile: number) => (mile / total).toFixed(4);
const homeLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebSite', name: 'EV Trip Reports', url: 'https://evtripreports.com/', description: 'Personal EV trip planning for any route.' },
  { '@type': 'Organization', name: 'EV Trip Reports', url: 'https://evtripreports.com/', description: 'A travel agent for EVs.' },
] };
---
<Base title="Custom EV road-trip plans" description="Custom EV trip plans for your car, route, and dates. See a sample plan with charging stops, available backups, and dated sources.">
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(homeLd)}></script>
  <div class="home">
    <section class="home-hero">
      <div class="wrap home-hero__grid">
        <div class="home-hero__copy">
          <h1 class="display">You Drive. We Plan the Charging.</h1>
          <p class="lede">A travel agent for EVs: a charging plan for your car, your route, and your dates, checked by a human before you get it.</p>
          <div class="btnrow home-hero__actions"><a class="pill pill--lg" href="/plans/#request">Plan My Trip</a><a class="text-link" href="/sample-plan/">Read the Sample Plan</a></div>
          <p class="small muted">From $19. Any route.</p>
        </div>
        <figure class="roadsign">
          <div class="roadsign__panel">
            <div class="roadsign__route"><span class="shield shield--lg" role="img" aria-label={route.highway}><span aria-hidden="true">{route.highway.replace(/^I-/, '')}</span></span><span>North</span></div>
            <dl class="roadsign__rows">
              {signRows.map((row) => (
                <div class:list={['roadsign__row', { 'is-charge': row.charge }]}>
                  <dt>{row.charge && <span class="ev-plate"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3v5M16 3v5M5.5 8h13v3.5a6.5 6.5 0 0 1-13 0V8ZM12 18v3" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="sr">Charge here:</span></span>}{row.name}</dt>
                  <dd><span class="sr">mile </span>{row.mile}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="roadsign__posts" aria-hidden="true"><span></span><span></span></div>
          <figcaption>Sample trip in an Ioniq 5: one stop, at {stop.name}. Not a current recommendation.</figcaption>
        </figure>
      </div>
    </section>

    <PhotoBand name="desert-highway" alt="Empty two-lane highway across a desert valley" credit="Peter Mizsak" href="https://unsplash.com/photos/highway-in-desert-oAYBm7nuIWY" eager />

    <section id="inside-plan" class="home-plan">
      <div class="wrap">
        <div class="home-plan__head">
          <h2 class="h1">What a Plan Looks Like</h2>
          <p class="lede">Which charger fits your car, why stop there, and where to go if it’s down.</p>
        </div>
        <div class="home-plan__grid">
          <div class="strip" aria-label={`Ontario to Las Vegas, ${total} miles. Charge at ${stop.name}; the other stops are optional.`}>
            <ol class="strip__track" style={`--miles:${total}`}>
              <li class="strip__point strip__point--end" style="--at:0"><span class="strip__mile">0</span><span class="strip__label"><strong>Ontario, CA</strong><span>Leave with 80%</span></span></li>
              {plan.stops.map((s: any) => s.charging ? (
                <li class="strip__point strip__point--charge" style={`--at:${at(s.mile)}`}><span class="strip__mile">{s.mile}</span><span class="strip__label"><strong>{s.name}</strong><span>Charge {strategy.arrivePercent}% to {strategy.departPercent}%</span></span></li>
              ) : (
                <li class="strip__point" style={`--at:${at(s.mile)}`}><span class="strip__mile">{s.mile}</span><span class="strip__label">{s.name}<span class="sr">, optional</span></span></li>
              ))}
              <li class="strip__point strip__point--end" style="--at:1"><span class="strip__mile">{total}</span><span class="strip__label"><strong>Las Vegas, NV</strong><span>Arrive with about {destination.arrivePercent}%</span></span></li>
            </ol>
            <p class="strip__key small muted">Grey stops are optional.</p>
          </div>

          <article class="stopcard">
            <header class="stopcard__head">
              <span class="milemarker"><span>Mile</span>{stop.mile}</span>
              <div><p class="stopcard__where">{stop.name}, California</p><h3 class="h2">{stop.primary.name}</h3><p class="muted">{stop.primary.network.value}</p></div>
            </header>
            <p class="stopcard__why">{stop.why}</p>
            <div class="gauge" role="group" aria-label="Estimated battery at this stop">
              <div class="gauge__bar" style={`--from:${strategy.arrivePercent}%;--to:${strategy.departPercent}%`} aria-hidden="true"></div>
              <dl class="gauge__nums"><div><dt>Arrive</dt><dd>{strategy.arrivePercent}%</dd></div><div><dt>Leave</dt><dd>{strategy.departPercent}%</dd></div></dl>
            </div>
            <p class="small muted">Estimate assumes 250 miles of range at 65 mph.</p>
            <dl class="sheet stopcard__sheet">
              <div class="sheet__row"><dt>Connection</dt><dd><span>CCS at the primary station</span></dd></div>
              <div class="sheet__row"><dt>Station power</dt><dd><span>{stop.primary.power.value}</span></dd></div>
              <div class="sheet__row"><dt>Facts checked</dt><dd><span>{fmtDate(stop.primary.network.checkedOn)}</span><a class="src" href={stop.primary.network.url} target="_blank" rel="noopener noreferrer">Source</a></dd></div>
            </dl>
            <div class="stopcard__backup">
              <h4>Backup: {backup.network}</h4>
              <p>{backup.name}. {backup.access}</p>
              <a class="src" href={backup.url} target="_blank" rel="noopener noreferrer">Source, {fmtDate(backup.checkedOn)}</a>
            </div>
            <div class="stopcard__caution">
              <h4>Before You Arrive</h4>
              <p>Check both stations in their apps. Restrooms and pet areas aren’t confirmed here.</p>
            </div>
            <a class="text-link" href="/sample-plan/">See the Full Sample Plan</a>
          </article>
        </div>
      </div>
    </section>

    <section class="home-prices" id="planning">
      <div class="wrap">
        <div class="home-prices__head">
          <h2 class="h1">Pick a Plan</h2>
        </div>
        <ul class="fares">
          {tiers.map((tier) => (
            <li class:list={['fare', { 'fare--featured': tier.id === 'detailed' }]}>
              <div class="fare__name"><h3 class="h3">{titleCase(tier.name)}</h3><p class="small muted">{tier.delivery}</p></div>
              <p class="fare__blurb">{tier.blurb}</p>
              <p class="fare__price">{tier.price}</p>
              <a class="pill" href={`/plans/?tier=${tier.id}#request`}>Choose {titleCase(tier.name)}</a>
            </li>
          ))}
        </ul>
        <a class="text-link" href="/plans/#compare">Compare Everything Included</a>
      </div>
    </section>
  </div>
</Base>
