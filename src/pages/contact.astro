---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" description="Contact EV Trip Reports for order help, trip questions, or charging station corrections.">
  <section class="band band--tight">
    <div class="wrap prose">
      <h1 class="h1">Contact</h1>
      <p class="lede">For trip questions, order help, or station corrections, email <a href="mailto:support@evtripreports.com">support@evtripreports.com</a>.</p>
      <p>If you’re writing about an order, use the email address you checked out with. If your plan is ready, you can also open it through <a href="/find-my-plans/">Find My Plans</a>.</p>
    </div>
  </section>
</Base>
