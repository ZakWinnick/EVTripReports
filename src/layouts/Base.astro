---
import '../styles/global.css';
import '../styles/guide.css';
import '../styles/field-guide.css';
import { newsletterForm } from '../lib/newsletter.js';

interface Props {
  title: string;
  description: string;
  path?: string;
  current?: string;
  noindex?: boolean;
  robots?: string;
  analytics?: boolean;
  referrer?: string;
}
const { title, description, path = '', current: currentProp = '', noindex = false, robots = 'noindex', analytics = true, referrer = '' } = Astro.props;
const fullTitle = `${title} | EV Trip Reports`;
const canonical = new URL(path || Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og.png', Astro.site).toString();
const current = String(currentProp || Astro.url.pathname);
const navCurrent = (href: string) => {
  const page = current.replace(/\/+$/, '') || '/';
  const link = href.replace(/\/+$/, '') || '/';
  return page === link ? 'page' : undefined;
};
const links = [
  { href: '/plans/', label: 'Custom Plans' },
  { href: '/sample-plan/', label: 'Sample Plan' },
  { href: '/methodology/', label: 'How We Check' },
  { href: '/about/', label: 'About' },
];
const menuLinks = [...links, { href: '/find-my-plans/', label: 'Find My Plans' }];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content={robots} />}
    {referrer && <meta name="referrer" content={referrer} />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="EV Trip Reports. A travel agent for EVs." />
    <meta property="og:site_name" content="EV Trip Reports" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/overpass-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    {analytics && <script is:inline src="https://tinylytics.app/embed/yTazdLcW53ZLKkX41y8k.js" defer></script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="wrap nav__in">
        <a class="brand" href="/" aria-label="EV Trip Reports home">
          <svg viewBox="0 0 30 22" aria-hidden="true"><rect width="30" height="22" rx="4" fill="#00704a"/><rect x="1.75" y="1.75" width="26.5" height="18.5" rx="2.6" fill="none" stroke="#fff" stroke-width="1.3"/><path d="M7 15.5V6.5h5M7 11h4M7 15.5h5M15.5 6.5l3 9 3-9" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
          EV Trip Reports
        </a>
        <nav class="nav__links" aria-label="Main">
          {links.map((l) => (
            <a href={l.href} aria-current={navCurrent(l.href)}>{l.label}</a>
          ))}
        </nav>
        <details class="menu">
          <summary>Menu</summary>
          <nav aria-label="Menu">
            {menuLinks.map((l) => (
              <a href={l.href} aria-current={navCurrent(l.href)}>{l.label}</a>
            ))}
          </nav>
        </details>
        <a class="pill" href="/plans/">Plan My Trip</a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap foot__signup newsletter-band" hidden>
        <Fragment set:html={newsletterForm('newsletter-footer')} />
      </div>
      <div class="wrap foot__grid">
        <div>
          <strong>EV Trip Reports</strong><br />
          Custom EV road-trip plans.<br />No network pays for placement.
        </div>
        <nav aria-label="Footer">
          <a href="/plans/">Custom Plans</a>
          <a href="/sample-plan/">Sample Plan</a>
          <a href="/find-my-plans/">Find My Plans</a>
          <a href="/faq/">FAQ</a>
          <a href="/methodology/">How We Check</a>
          <a href="/about/">About</a>
          <a href="/terms/">Terms</a>
          <a href="/privacy/">Privacy</a>
          <a href="mailto:support@evtripreports.com">Contact</a>
        </nav>
      </div>
    </footer>
    <script>
      import { mountNewsletterForms } from '../lib/turnstile-client.js';
      mountNewsletterForms();
      import { mountFieldGuide } from '../lib/field-guide-client.js';
      mountFieldGuide();
    </script>
  </body>
</html>
