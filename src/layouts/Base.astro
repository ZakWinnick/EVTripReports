---
import '../styles/global.css';
import '../styles/guide.css';
import { newsletterForm } from '../lib/newsletter.js';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  robots?: string;
  analytics?: boolean;
  referrer?: string;
}
const { title, description, path = '', noindex = false, robots = 'noindex', analytics = true, referrer = '' } = Astro.props;
const fullTitle = title === 'EV Trip Reports' ? title : `${title} | EV Trip Reports`;
const canonical = new URL(path || Astro.url.pathname, Astro.site).toString();
const current = Astro.url.pathname.replace(/\/$/, '');
const links = [
  { href: '/#guides', label: 'Guides' },
  { href: '/plans', label: 'Custom plans' },
  { href: '/faq', label: 'FAQ' },
  { href: '/methodology', label: 'How we check' },
  { href: '/about', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content={robots} />}
    {referrer && <meta name="referrer" content={referrer} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <slot name="head" />
    {analytics && <script is:inline src="https://tinylytics.app/embed/yTazdLcW53ZLKkX41y8k.js" defer></script>}
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav__in">
        <a class="brand" href="/" aria-label="EV Trip Reports home">
          <svg viewBox="0 0 22 22" aria-hidden="true"><circle cx="4" cy="11" r="3" fill="#15191a"/><circle cx="18" cy="11" r="3" fill="#1e5a3c"/><path d="M7 11h8" stroke="#15191a" stroke-width="2"/></svg>
          EV Trip Reports
        </a>
        <nav class="nav__links" aria-label="Main">
          {links.map((l) => (
            <a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a>
          ))}
        </nav>
        <a class="pill" href="/plans#request">Plan my trip</a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap foot__signup newsletter-band" hidden>
        <Fragment set:html={newsletterForm('newsletter-footer')} />
      </div>
      <div class="wrap foot__grid">
        <div>
          <strong style="color: var(--ink)">EV Trip Reports</strong><br />
          Independent. No charging network pays for placement or coverage.
        </div>
        <nav aria-label="Footer">
          <a href="/#guides">Guides</a>
          <a href="/plans">Custom plans</a>
          <a href="/find-my-plans">Find my plans</a>
          <a href="/faq">FAQ</a>
          <a href="/methodology">How we check</a>
          <a href="/about">About</a>
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var forms = Array.prototype.slice.call(document.querySelectorAll('form.newsletter'));
        if (!forms.length) return;
        var widgets = new WeakMap();

        function setOpen(open) {
          forms.forEach(function (form) {
            var band = form.closest('.newsletter-band');
            form.hidden = !open;
            if (band) band.hidden = !open;
          });
        }

        setOpen(false);

        function loadTurnstile() {
          return new Promise(function (resolve, reject) {
            if (window.turnstile) { resolve(); return; }
            var existing = document.querySelector('script[src*="challenges.cloudflare.com/turnstile/v0/api.js"]');
            if (existing) {
              if (window.turnstile) { resolve(); return; }
              existing.addEventListener('load', function () { resolve(); }, { once: true });
              existing.addEventListener('error', function () { reject(new Error('turnstile')); }, { once: true });
              return;
            }
            var s = document.createElement('script');
            s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
            s.async = true;
            s.onload = function () { resolve(); };
            s.onerror = function () { reject(new Error('turnstile')); };
            document.head.appendChild(s);
          });
        }

        fetch('/api/subscribe').then(function (res) {
          if (!res.ok) return null;
          return res.json();
        }).then(function (body) {
          if (!body || body.open !== true) return;
          setOpen(true);
          var sitekey = body && body.turnstileSiteKey;
          if (!sitekey) return;
          return loadTurnstile().then(function () {
            forms.forEach(function (form) {
              var slot = form.querySelector('.newsletter__slot');
              if (!slot || !window.turnstile) return;
              slot.hidden = false;
              widgets.set(form, window.turnstile.render(slot, { sitekey: sitekey, action: 'newsletter_signup' }));
            });
          });
        }).catch(function () {});

        forms.forEach(function (form) {
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var msg = form.querySelector('.newsletter__msg');
            var btn = form.querySelector('button[type="submit"]');
            if (!msg || !btn || btn.disabled) return;
            msg.className = 'newsletter__msg';
            msg.textContent = '';
            if (!form.checkValidity()) {
              msg.textContent = 'Enter an email address.';
              msg.classList.add('is-err');
              var bad = form.querySelector(':invalid');
              if (bad) bad.focus();
              return;
            }
            var fd = new FormData(form);
            var data = { email: String(fd.get('email') || '').trim() };
            var honey = fd.get('website');
            if (honey) data.website = String(honey);
            var widgetId = widgets.get(form);
            if (widgetId && window.turnstile) data['cf-turnstile-response'] = window.turnstile.getResponse(widgetId);
            var label = btn.textContent;
            btn.disabled = true;
            btn.textContent = 'Sending';
            fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify(data),
            }).then(function (res) {
              return res.json().catch(function () { return {}; }).then(function (body) {
                return { res: res, body: body };
              });
            }).then(function (out) {
              if (out.res.ok) {
                form.reset();
                msg.textContent = out.body.already ? 'That email is already signed up.' : 'Check your email to confirm.';
                msg.classList.add('is-ok');
              } else if (out.res.status === 503 || out.res.status === 404 || out.res.status === 405) {
                msg.textContent = out.body.error || 'Newsletter signup is not open yet.';
                msg.classList.add('is-err');
              } else {
                msg.textContent = out.body.error || 'Signup did not go through. Try again.';
                msg.classList.add('is-err');
              }
            }).catch(function () {
              msg.textContent = 'Signup did not go through because the connection dropped. Try again.';
              msg.classList.add('is-err');
            }).then(function () {
              btn.disabled = false;
              btn.textContent = label;
              var id = widgets.get(form);
              if (id && window.turnstile) window.turnstile.reset(id);
            });
          });
        });
      })();
    </script>
  </body>
</html>
