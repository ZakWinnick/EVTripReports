/*
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://tinylytics.app https://static.cloudflareinsights.com https://challenges.cloudflare.com; connect-src 'self' https://tinylytics.app https://cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; img-src 'self' data: https://tinylytics.app; style-src 'self' 'unsafe-inline'; font-src 'self'; form-action 'self' https://buy.stripe.com https://checkout.stripe.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  ! Access-Control-Allow-Origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/portal-shell/*
  X-Robots-Tag: noindex, nofollow

/guide-shell/*
  X-Robots-Tag: noindex, nofollow

/404.html
  X-Robots-Tag: noindex, nofollow

/404/*
  X-Robots-Tag: noindex, nofollow

/data/*
  X-Robots-Tag: noindex

/guides/*
  X-Etr-Guide: 1

/plan/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/find-my-plans/open/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/find-my-plans/list
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
